# ---------------------------------------------------------------
# Numex E-Ticaret — ortam değişkenleri örneği
# Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
# .env ASLA GitHub'a gönderilmez (.gitignore'da).
# ---------------------------------------------------------------

# Uygulama
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# Oturum anahtarı (rastgele uzun bir metin)
SESSION_SECRET=buraya-rastgele-bir-anahtar-yazin

# Yönetim paneli ilk kullanıcı (ilk açılışta oluşturulur)
ADMIN_EMAIL=admin@ornek.com
ADMIN_PASSWORD=buraya-guclu-bir-sifre-yazin

# Stripe — test anahtarları ile başlayın, canlıda sk_live_ kullanın
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Ödeme modu: true ise Stripe anahtarı yoksa bile sipariş "kapıda ödeme" olarak düşer
ALLOW_COD_FALLBACK=true

# iyzico — DENEYSEL, HENÜZ ÇALIŞMIYOR (README). IYZICO_DENEYSEL=true olmadan ödeme sayfasında görünmez.
IYZICO_DENEYSEL=false
# https://sandbox-merchant.iyzipay.com → API anahtarları
# Sandbox: https://sandbox-api.iyzipay.com · Canlı: https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
