<%- include('partials/ust', { baslik: baslik }) %>

<div class="kap">
  <div class="bolum" style="padding-bottom:0;">
    <div class="bolum-baslik">
      <div>
        <div class="ust-yazi">Ödeme</div>
        <h1>Sipariş bilgileri</h1>
      </div>
      <p>Bilgilerini gir, ödeme sayfasına yönlendirileceksin.</p>
    </div>
  </div>

  <div class="iki-kolon" style="padding-bottom:48px;">
    <form action="/odeme" method="post" style="background:var(--kart); border:1px solid var(--cizgi); border-radius:var(--yaricap); padding:clamp(16px,2.4vw,26px);">
      <h3 style="margin-bottom:16px;">Teslimat ve iletişim</h3>
      <div class="form-izgara">
        <div class="alan">
          <label for="customer_name">Ad soyad *</label>
          <input id="customer_name" type="text" name="customer_name" required autocomplete="name">
        </div>
        <div class="alan">
          <label for="customer_email">E-posta *</label>
          <input id="customer_email" type="email" name="customer_email" required autocomplete="email">
          <span class="ipucu">Sipariş bilgileri bu adrese gönderilir.</span>
        </div>
        <div class="alan">
          <label for="customer_phone">Telefon</label>
          <input id="customer_phone" type="tel" name="customer_phone" autocomplete="tel">
        </div>
        <div class="alan">
          <label for="city">Şehir *</label>
          <input id="city" type="text" name="city" required autocomplete="address-level2">
        </div>
        <div class="alan tam">
          <label for="address">Açık adres *</label>
          <textarea id="address" name="address" required autocomplete="street-address"></textarea>
        </div>
        <div class="alan tam">
          <label for="note">Sipariş notu</label>
          <textarea id="note" name="note" placeholder="Kargo veya teslimatla ilgili notun (isteğe bağlı)"></textarea>
        </div>
      </div>

      <% if (yontemler.length > 0) { %>
        <h3 style="margin:20px 0 12px;">Ödeme yöntemi</h3>
        <div class="odeme-secim">
          <% if (stripeAktif) { %>
            <label class="odeme-secim-kart">
              <input type="radio" name="payment_method" value="stripe" checked>
              <span>
                <strong>Kredi / banka kartı</strong>
                <small>Stripe güvenli ödeme sayfası · 3D Secure destekli</small>
              </span>
            </label>
          <% } %>
          <% if (iyzicoAktif) { %>
            <label class="odeme-secim-kart">
              <input type="radio" name="payment_method" value="iyzico" <%= stripeAktif ? '' : 'checked' %>>
              <span>
                <strong>iyzico ile öde</strong>
                <small>Türkiye'nin yerel ödeme altyapısı · 3D Secure</small>
              </span>
            </label>
          <% } %>
        </div>
      <% } else { %>
        <div class="uyari-kutu" style="background:var(--zemin-koyu); border-color:var(--cizgi); color:var(--murekkep-soluk); margin:18px 0;">
          Canlı ödeme sağlayıcısı tanımlı değil — sipariş <strong>kapıda ödeme</strong> olarak kaydedilecek.
          Canlı ödeme için <code>.env</code> dosyasına Stripe anahtarlarını ekleyin.
        </div>
      <% } %>

      <label class="onay-kutu">
        <input type="checkbox" name="sozlesme_onay" value="1" required>
        <span><a href="/yasal#mesafeli-satis" target="_blank" rel="noopener">Mesafeli satış sözleşmesini</a>,
          <a href="/yasal#on-bilgilendirme" target="_blank" rel="noopener">ön bilgilendirme formunu</a> ve
          <a href="/yasal#kvkk" target="_blank" rel="noopener">KVKK aydınlatma metnini</a> okudum, onaylıyorum. *</span>
      </label>

      <button class="btn btn-birincil btn-tam" type="submit" style="margin-top:16px;">
        <%= yontemler.length > 0 ? 'Ödeme sayfasına git' : 'Siparişi oluştur' %>
      </button>
    </form>

    <aside class="ozet-kart">
      <h3 style="margin-bottom:14px;">Sepet özeti</h3>
      <% cart.forEach(function (it) { %>
        <div class="ozet-satir">
          <span><%= it.name %> × <%= it.quantity %></span>
          <span style="color:var(--murekkep);"><%= tl(it.price * it.quantity) %></span>
        </div>
      <% }); %>
      <div class="ozet-satir toplam">
        <span>Genel toplam</span>
        <span><%= tl(toplam) %></span>
      </div>
      <a class="btn btn-ikincil btn-tam" href="/sepet" style="margin-top:14px;">Sepeti düzenle</a>
    </aside>
  </div>
</div>

<%- include('partials/alt') %>
