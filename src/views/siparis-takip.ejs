<%- include('partials/ust', { baslik: baslik }) %>

<div class="kap">
  <div class="bolum">
    <div style="max-width:560px; margin-bottom:28px;">
      <div class="ust-yazi" style="font-size:.76rem; letter-spacing:.16em; text-transform:uppercase; color:var(--vurgu); font-weight:700; margin-bottom:6px;">Takip</div>
      <h1>Sipariş takibi</h1>
      <p style="color:var(--murekkep-soluk);">Sipariş kodunu ve sipariş sırasında verdiğin e-posta adresini gir.</p>
    </div>

    <% if (hata) { %>
      <div class="uyari-kutu hata" style="max-width:560px; margin-bottom:18px;"><%= hata %></div>
    <% } %>

    <form action="/siparis-takip" method="post" style="background:var(--kart); border:1px solid var(--cizgi); border-radius:var(--yaricap); padding:clamp(16px,2.4vw,24px); max-width:560px;">
      <div class="form-izgara">
        <div class="alan">
          <label for="order_code">Sipariş kodu</label>
          <input id="order_code" type="text" name="order_code" value="<%= kod %>" placeholder="NMX-20261102-A1B2C3" required>
        </div>
        <div class="alan">
          <label for="email">E-posta</label>
          <input id="email" type="email" name="email" value="<%= email %>" required>
        </div>
      </div>
      <button class="btn btn-birincil" type="submit" style="margin-top:16px;">Sorgula</button>
    </form>

    <% if (siparis) { %>
      <div style="margin-top:34px; max-width:760px;">
        <h2><%= siparis.order_code %></h2>
        <div class="ozet-kart" style="position:static; margin-bottom:18px;">
          <div class="ozet-satir"><span>Sipariş durumu</span><span class="durum <%= siparis.status %>"><%= DURUM_ETIKET[siparis.status] || siparis.status %></span></div>
          <div class="ozet-satir"><span>Ödeme durumu</span><span class="durum <%= siparis.payment_status %>"><%= ODEME_ETIKET[siparis.payment_status] || siparis.payment_status %></span></div>
          <div class="ozet-satir"><span>Tarih</span><span style="color:var(--murekkep);"><%= tarih(siparis.created_at) %></span></div>
          <div class="ozet-satir toplam"><span>Toplam</span><span><%= tl(siparis.total) %></span></div>
        </div>

        <div class="tablo-sar">
          <table>
            <thead>
              <tr><th>Ürün</th><th class="sag">Adet</th><th class="sag">Tutar</th></tr>
            </thead>
            <tbody>
              <% kalemler.forEach(function (k) { %>
                <tr>
                  <td><%= k.product_name %></td>
                  <td class="sag"><%= k.quantity %></td>
                  <td class="sag"><%= tl(k.unit_price * k.quantity) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/alt') %>
