<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= baslik %> · Numex Yönetim</title>
  <link rel="stylesheet" href="/css/stil.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%231c2126'/%3E%3Ctext x='16' y='23' font-family='Segoe UI,sans-serif' font-size='19' font-weight='700' fill='%23b4472c' text-anchor='middle'%3EN%3C/text%3E%3C/svg%3E">
</head>
<body class="admin-govde">
<div class="giris-sayfa">
  <div class="giris-kart">
    <div class="marka" style="margin-bottom:6px;">Numex<span class="nokta">.</span> <small>Yönetim</small></div>
    <p class="alt">Panele devam etmek için yönetici hesabınla giriş yap.</p>
    <% if (typeof demoModu !== 'undefined' && demoModu) { %><div class="uyari-kutu" style="margin-bottom:16px;">Canlı demo girişi: <strong>demo@ornek.com</strong> / <strong>demo1234</strong> (salt okunur)</div><% } %>

    <% if (flashError && flashError.length) { %>
      <div class="uyari-kutu hata" style="margin-bottom:16px;"><%= flashError[0] %></div>
    <% } %>
    <% if (flashSuccess && flashSuccess.length) { %>
      <div class="uyari-kutu basari" style="margin-bottom:16px;"><%= flashSuccess[0] %></div>
    <% } %>

    <form action="/admin/giris" method="post">
      <div class="alan">
        <label for="email">E-posta</label>
        <input id="email" type="email" name="email" required autocomplete="username" autofocus>
      </div>
      <div class="alan">
        <label for="password">Şifre</label>
        <input id="password" type="password" name="password" required autocomplete="current-password">
      </div>
      <button class="btn btn-birincil btn-tam" type="submit" style="margin-top:10px;">Giriş yap</button>
    </form>

    <p style="margin:18px 0 0; font-size:.8rem; color:var(--murekkep-soluk); line-height:1.55;">
      İlk kurulumda yönetici hesabı <code>.env</code> dosyasındaki
      <code>ADMIN_EMAIL</code> ve <code>ADMIN_PASSWORD</code> değerleriyle oluşturulur.
    </p>
    <a href="/" style="display:inline-block; margin-top:14px; font-size:.84rem; color:var(--vurgu);">← Mağazaya dön</a>
  </div>
</div>
</body>
</html>
